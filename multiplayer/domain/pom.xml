<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.perso.t4c</groupId>
        <artifactId>multiplayer</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>game-domain</artifactId>
    <dependencies>
        <dependency>
            <groupId>com.perso.t4c</groupId>
            <artifactId>game-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
    </dependencies>
    <build>
        <!-- Compatibility artifact: focused domain tests use the one shared game-runtime jar. -->
        <testSourceDirectory>${project.basedir}/../../src/test/java</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testIncludes>
                        <testInclude>com/perso/T4C/monster/core/MonsterPursuitRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/monster/core/MonsterSpellDamageRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/quest/QuestRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/spell/SpellKeysTest.java</testInclude>
                        <testInclude>com/perso/T4C/spell/SpellCastRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/spell/SpellHealRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/spell/SpellFormulaContextsTest.java</testInclude>
                        <testInclude>com/perso/T4C/world/LineOfSightRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/world/MovementRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/world/MovementReconcilerTest.java</testInclude>
                        <testInclude>com/perso/T4C/combat/CombatResolverTest.java</testInclude>
                        <testInclude>com/perso/T4C/combat/WeaponDamageRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/combat/WeaponTimingRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/combat/EquipmentBoostRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/combat/RegenerationRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/combat/QuiverSplashTest.java</testInclude>
                        <testInclude>com/perso/T4C/helper/DiceFormulaTest.java</testInclude>
                        <testInclude>com/perso/T4C/helper/GridPathfindingParityTest.java</testInclude>
                        <testInclude>com/perso/T4C/helper/CharacterCreationRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/world/WorldCollisionTest.java</testInclude>
                        <testInclude>com/perso/T4C/item/CarryCapacityRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/item/ShopRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/online/model/GroundLootModelsTest.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
