<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.perso.t4c</groupId>
        <artifactId>multiplayer</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>game-domain</artifactId>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <!-- Transitional boundary: compile the same source and tests as offline play, without
             moving files or depending on the desktop artifact. No copied gameplay formulas. -->
        <sourceDirectory>${project.basedir}/../../src/main/java</sourceDirectory>
        <testSourceDirectory>${project.basedir}/../../src/test/java</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>com/perso/T4C/death/DeathRules.java</include>
                        <include>com/perso/T4C/quest/CrimsonscaleLetterRules.java</include>
                        <include>com/perso/T4C/combat/CombatProfile.java</include>
                        <include>com/perso/T4C/combat/MonsterCombatRules.java</include>
                        <include>com/perso/T4C/monster/loot/LootTable.java</include>
                        <include>com/perso/T4C/monster/loot/LootEntry.java</include>
                        <include>com/perso/T4C/monster/loot/LootResult.java</include>
                        <include>com/perso/T4C/combat/CombatResolver.java</include>
                        <include>com/perso/T4C/combat/CombatResult.java</include>
                        <include>com/perso/T4C/combat/PhysicalAttackRequest.java</include>
                        <include>com/perso/T4C/combat/WeaponDamageRules.java</include>
                        <include>com/perso/T4C/combat/WeaponTimingRules.java</include>
                        <include>com/perso/T4C/combat/EquipmentBoostRules.java</include>
                        <include>com/perso/T4C/combat/EquipmentEligibilityRules.java</include>
                        <include>com/perso/T4C/combat/SkillBonusRules.java</include>
                        <include>com/perso/T4C/helper/DiceFormula.java</include>
                        <include>com/perso/T4C/world/WorldCollision.java</include>
                        <include>com/perso/T4C/world/CollisionRules.java</include>
                        <include>com/perso/T4C/config/GameConstants.java</include>
                        <include>com/perso/T4C/helper/BinaryIOUtils.java</include>
                        <include>com/perso/T4C/helper/CharacterCreationRules.java</include>
                        <include>com/perso/T4C/helper/CharacterClass.java</include>
                        <include>com/perso/T4C/helper/CharacterStartingKit.java</include>
                        <include>com/perso/T4C/player/BodyPart.java</include>
                        <include>com/perso/T4C/player/ProgressionState.java</include>
                        <include>com/perso/T4C/player/PlayerProgression.java</include>
                        <include>com/perso/T4C/helper/XpCurve.java</include>
                        <include>com/perso/T4C/mapping/definition/XpCurveDefinitions.java</include>
                        <include>com/perso/T4C/monster/core/MonsterExperience.java</include>
                        <include>com/perso/T4C/online/model/*.java</include>
                        <include>com/perso/T4C/monster/core/MonsterDef.java</include>
                    </includes>
                    <testIncludes>
                        <testInclude>com/perso/T4C/combat/CombatResolverTest.java</testInclude>
                        <testInclude>com/perso/T4C/combat/WeaponDamageRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/combat/WeaponTimingRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/combat/EquipmentBoostRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/helper/DiceFormulaTest.java</testInclude>
                        <testInclude>com/perso/T4C/helper/CharacterCreationRulesTest.java</testInclude>
                        <testInclude>com/perso/T4C/world/WorldCollisionTest.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
