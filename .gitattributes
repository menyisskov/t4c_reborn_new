# Aucun fichier n'est suivi par Git LFS.
# Les assets volumineux (maps, sprites, sons) ne sont pas versionnes :
# ils vivent sur disque et sont ignores (voir .gitignore).
# Les petits .bin de donnees (items, monsters, npcs, mappings...)
# sont stockes en clair.

# Shell scripts run inside WSL/Linux; CRLF would break them.
*.sh text eol=lf

# Exported content is compared byte for byte by freshness tests; keep LF on Windows checkouts.
multiplayer/server/src/main/resources/content/*.json text eol=lf
